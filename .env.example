# ==========================================
# Required Authentication Keys
# ==========================================

# 1. Groq API Key
# Used for Whisper Speech-to-Text (whisper-large-v3) and openai/gpt-oss-20b MoM Summarization
# Get your key at: https://console.groq.com/keys

GROQ_API_KEY="your-api-key-here"

# 2. Deepgram API Key
# Used for Deepgram Speech-to-Text (alternative to Groq Whisper)
DEEPGRAM_API_KEY="your-deepgram-api-key-here"


# FastAPI Server Config 
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Groq Model Selections (Defaults configured in settings.py)
GROQ_WHISPER_MODEL="whisper-large-v3"
GROQ_LLM_MODEL="openai/gpt-oss-20b"

